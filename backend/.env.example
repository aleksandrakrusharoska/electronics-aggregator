SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Comma-separated list of extra allowed frontend origins (besides localhost:5173).
# Set this on Railway/Render to your Vercel deployment URL.
ALLOWED_ORIGINS=https://your-app.vercel.app

# Dedicated Groq key for the ad-chat feature — keep this separate from the
# GROQ_API_KEY used by the scraping pipeline (scrapy_project/), otherwise
# the scraper's daily usage can exhaust chat's quota for the day.
CHAT_GROQ_API_KEY=your-groq-api-key

# Proxy for pazar3.mk/reklama5.com scrapers — needed if the sites 403 the
# Render worker's IP (they datacenter-block GitHub Actions / cloud IPs).
# Format: http://username:password@host:port/
PROXY_URL=
